// Task Flow (Kanban Board) — Database schema
// Source of requirements: user_stories.md (US-01 … US-30)
// Target database: PostgreSQL 15+
// Paste into https://dbdiagram.io or run `dbml2sql database_schema.dbml --postgres`.

Project task_flow {
  database_type: 'PostgreSQL'
  Note: '''
  # Task Flow — Kanban board

  ## Story coverage
  | Stories        | Tables |
  |----------------|--------|
  | US-01, US-02   | users, sessions |
  | US-03 – US-07  | boards (incl. visibility), board_members, board_columns |
  | US-08 – US-12  | tasks |
  | US-13 – US-16  | tasks (assignee_id, due_date, priority) |
  | US-17          | task_comments |
  | US-18          | checklist_items |
  | US-19 – US-24  | tasks (state, archived_*, trashed_*, state_before_trash) |
  | US-25          | ON DELETE CASCADE from boards |
  | US-26, US-27   | activities |
  | US-28          | tasks.version (optimistic locking) |
  | US-29, US-30   | no extra tables (see notes on activities) |

  ## Conventions
  - Every primary key is an auto-incrementing `bigint`
    (GENERATED BY DEFAULT AS IDENTITY); every foreign key is `bigint`.
  - IDs are sequential and easy to guess, so the API must never trust an id
    on its own: every board, task, comment and checklist request first checks
    that the current user is in board_members for that board.
  - All timestamps are `timestamptz` in UTC.
  - Text limits from the stories are enforced with `varchar(n)` or CHECK constraints (see table notes).
  '''
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

Enum board_role {
  owner  [note: 'Created the board. Exactly one per board.']
  member [note: 'Invited by the owner. All members have the same permissions.']
}

Enum board_visibility {
  private [note: 'Only the owner is on the board (US-03, US-07)']
  shared  [note: 'The owner has added at least one member (US-06)']
}

Enum column_kind {
  todo        [note: 'To Do']
  in_progress [note: 'In Progress']
  done        [note: 'Done — tasks here are never shown as overdue (US-14)']
}

Enum task_state {
  active   [note: 'Visible on the board']
  archived [note: 'Hidden, read-only, kept indefinitely (US-19, US-20)']
  trashed  [note: 'Deleted, restorable until permanently deleted (US-21 – US-24)']
}

Enum task_priority {
  low
  medium
  high
}

Enum activity_action {
  // Board and membership (US-27)
  board_created
  board_renamed
  member_added            [note: 'details: {"user_id"}; may also switch the board to shared']
  member_removed          [note: 'details: {"user_id"}; may also switch the board to private']
  // Task lifecycle (US-26)
  task_created
  task_edited             [note: 'details: {"fields": ["title", "description"]} — never the text itself']
  task_moved              [note: 'details: {"from_column_id", "to_column_id"}']
  task_assigned           [note: 'details: {"from_user_id", "to_user_id"}']
  task_unassigned         [note: 'details: {"from_user_id"}']
  task_due_date_changed   [note: 'details: {"from", "to"} (ISO dates or null)']
  task_priority_changed   [note: 'details: {"from", "to"}']
  task_archived
  task_unarchived
  task_trashed
  task_restored           [note: 'details: {"restored_to": "active" | "archived"}']
  task_deleted_permanently [note: 'task_id is set to NULL by the FK; no task content kept (US-23)']
  trash_emptied           [note: 'details: {"count"} (US-24)']
}

// ─────────────────────────────────────────────
// Epic A — Boards and access
// ─────────────────────────────────────────────

Table users {
  id            bigint       [pk, increment]
  name          varchar(100) [not null]
  email         varchar(255) [not null, note: 'Stored lower-cased and trimmed']
  password_hash text         [not null, note: 'Hash only, never the password. bcrypt = 60 chars, argon2id ≈ 100 chars; text fits any algorithm. The 8+ character rule is checked before hashing (US-01).']
  avatar_url    text         [note: 'Shown on cards for the assignee (US-13)']
  created_at    timestamptz  [not null, default: `now()`]
  updated_at    timestamptz  [not null, default: `now()`]

  indexes {
    email [unique, name: 'users_email_key', note: 'US-01: email must not already be registered']
  }

  Note: 'US-01 sign up, US-02 log in.'
}

Table sessions {
  id           bigint      [pk, increment]
  user_id      bigint      [not null]
  token_hash   bytea       [not null, note: 'SHA-256 of the session token; the raw token only lives in the cookie']
  created_at   timestamptz [not null, default: `now()`]
  last_seen_at timestamptz [not null, default: `now()`]
  expires_at   timestamptz [not null]
  revoked_at   timestamptz [note: 'Set on logout (US-02)']

  indexes {
    token_hash [unique, name: 'sessions_token_hash_key']
    user_id    [name: 'sessions_user_id_idx']
  }

  Note: '''
  US-02: a request is authenticated only if a session exists with
  revoked_at IS NULL AND expires_at > now(). Logging out sets revoked_at.
  FK: ON DELETE CASCADE from users.
  '''
}

Table boards {
  id         bigint           [pk, increment]
  name       varchar(100)     [not null, note: 'CHECK: not blank after trimming — US-03, US-05']
  owner_id   bigint           [not null]
  visibility board_visibility [not null, default: 'private', note: 'Set by the app, never by the user directly. See table note.']
  created_at timestamptz      [not null, default: `now()`]
  updated_at timestamptz      [not null, default: `now()`, note: 'Bumped by the app on any change inside the board; shown as "last updated" in the board list (US-04)']

  indexes {
    owner_id [name: 'boards_owner_id_idx']
  }

  Note: '''
  US-03 create, US-05 rename, US-25 delete.

  ## Visibility (US-03, US-04, US-06, US-07)
  - A new board is always private (only the owner is on it).
  - Adding a member: in the same transaction, set visibility = shared.
  - Removing a member: in the same transaction, if no members other than
    the owner are left, set visibility = private.
  - Invariant: visibility = shared exactly when board_members has more than
    one row for the board.

  ## Delete (US-25)
  Deleting a board is a hard DELETE: every child table references boards
  (directly or through tasks) with ON DELETE CASCADE, so columns, tasks
  (active, archived and trashed), comments, checklists, members and
  activities are all removed in one statement. The double confirmation
  (type the board name) is a UI/API check, not a database concern.
  '''
}

Table board_members {
  board_id  bigint      [not null]
  user_id   bigint      [not null]
  role      board_role  [not null, default: 'member']
  added_by  bigint      [note: 'NULL for the owner row']
  joined_at timestamptz [not null, default: `now()`]

  indexes {
    (board_id, user_id) [pk]
    user_id             [name: 'board_members_user_id_idx', note: 'US-04: list my boards']
  }

  Note: '''
  US-04, US-06, US-07. The owner also has a row here (role = owner), so
  "boards I own or am a member of" is a single join and every permission
  check is one lookup.
  - Partial unique index (raw SQL): UNIQUE (board_id) WHERE role = 'owner'
    → exactly one owner per board, kept in sync with boards.owner_id.
  - US-06: inviting an existing member hits the PK → "already a member".
    Adding a member also sets boards.visibility = shared.
  - US-07: removing a member deletes the row and, in the same transaction,
    sets tasks.assignee_id = NULL for that user's tasks on this board and
    sets boards.visibility = private if only the owner is left.
    The owner row can't be deleted (app check).
  FK: ON DELETE CASCADE from boards and users.
  '''
}

Table board_columns {
  id       bigint      [pk, increment]
  board_id bigint      [not null]
  kind     column_kind [not null]
  name     varchar(50) [not null, note: 'Display name: To Do / In Progress / Done']
  position smallint    [not null, note: 'Left-to-right order of the columns on the board: 0, 1, 2']

  indexes {
    (board_id, kind)     [unique, name: 'board_columns_board_kind_key']
    (board_id, position) [unique, name: 'board_columns_board_position_key']
    (id, board_id)       [unique, name: 'board_columns_id_board_key', note: 'Target of the composite FK from tasks']
  }

  Note: '''
  US-03: the three fixed columns are inserted in the same transaction that
  creates the board. Columns can't be added, renamed, reordered or deleted
  in v1. Kept as rows (not a hard-coded enum on tasks) so custom columns can
  be added later without a migration of tasks.
  board_columns.position is not related to tasks.position: a task points to
  its column through tasks.column_id, and tasks.position only orders tasks
  inside that column.
  FK: ON DELETE CASCADE from boards.
  '''
}

// ─────────────────────────────────────────────
// Epic B — Create and manage tasks
// Epic C — Archive, trash, recovery and delete
// ─────────────────────────────────────────────

Table tasks {
  id                 bigint        [pk, increment]
  board_id           bigint        [not null, note: 'Denormalised from the column for fast board/trash/archive queries']
  column_id          bigint        [not null, note: 'Kept while archived or trashed so the task can return to its original column (US-20, US-22)']
  title              varchar(200)  [not null, note: 'CHECK: not blank after trimming — US-08']
  description        text          [note: 'CHECK (char_length(description) <= 5000) — US-08']
  position           bigint        [not null, note: 'Top-to-bottom order inside its column only (US-11, US-12). See table note.']

  // US-13 – US-15
  assignee_id        bigint        [note: 'At most one assignee; must be a board member (checked in the same transaction)']
  due_date           date          [note: 'US-14']
  priority           task_priority [note: 'NULL = no priority (US-15)']

  // US-19 – US-22
  state              task_state    [not null, default: 'active']
  archived_at        timestamptz
  archived_by        bigint
  trashed_at         timestamptz
  trashed_by         bigint
  state_before_trash task_state    [note: 'active or archived; tells restore where to send the task (US-22)']

  // US-28
  version            integer       [not null, default: 1, note: 'Optimistic lock: UPDATE … WHERE id = $1 AND version = $2, then version + 1. 0 rows updated → conflict.']

  created_by         bigint        [not null]
  created_at         timestamptz   [not null, default: `now()`]
  updated_by         bigint
  updated_at         timestamptz   [not null, default: `now()`]

  indexes {
    (column_id, state, position) [name: 'tasks_column_state_position_idx', note: 'Render a column in order (US-08, US-11, US-12)']
    (board_id, state)            [name: 'tasks_board_state_idx', note: 'Board view, archive view, trash view, empty trash (US-20, US-22, US-24)']
    assignee_id                  [name: 'tasks_assignee_id_idx', note: 'Filter by assignee (US-16)']
    (board_id, due_date)         [name: 'tasks_board_due_date_idx', note: 'Filter by due date / overdue (US-14, US-16)']
    (board_id, priority)         [name: 'tasks_board_priority_idx', note: 'Filter by priority (US-16)']
  }

  Note: '''
  ## State rules (CHECK constraints in the migration)
  - state = 'active'   → archived_at IS NULL AND trashed_at IS NULL
  - state = 'archived' → archived_at, archived_by NOT NULL; trashed_at IS NULL
  - state = 'trashed'  → trashed_at, trashed_by, state_before_trash NOT NULL
  - state_before_trash IN ('active', 'archived') OR NULL
  - column_id always belongs to the same board_id: enforced by the composite FK
    (column_id, board_id) → board_columns (id, board_id).

  ## Lifecycle
  - Archive (US-19):   state = archived, set archived_at/by.
  - Unarchive (US-20): state = active, clear archived_*, position = bottom of column_id.
  - Trash (US-21):     state_before_trash = current state, state = trashed, set trashed_at/by.
                       The 5–10 s "Undo" toast simply calls restore.
  - Restore (US-22):   state = state_before_trash, clear trashed_* (and position = bottom if active).
  - Permanent delete (US-23) and empty trash (US-24): DELETE … WHERE state = 'trashed'.
    Comments and checklist items cascade; activity rows keep task_id = NULL.
  - Archived tasks are read-only (US-20): the API rejects edits unless state = 'active'.

  ## Ordering (US-11, US-12)
  tasks.position orders tasks inside one column (scope = column_id). It has
  nothing to do with board_columns.position, which orders the columns.
  New tasks get max(position) + 1024 in the column (bottom, US-08).
  A drop between two tasks takes the midpoint of their positions. When the
  gap is used up (neighbours differ by 1) the app renumbers that column in
  steps of 1024 inside one transaction. Moving to another column changes
  column_id and gives a new position in the target column.
  Concurrent moves of different tasks never overwrite each other (US-28).

  ## Search (US-16)
  Case-insensitive search on title and description:
  CREATE EXTENSION pg_trgm;
  CREATE INDEX tasks_search_trgm_idx ON tasks
    USING gin ((title || ' ' || coalesce(description, '')) gin_trgm_ops);
  Queries always add state = 'active' (archived and trashed are excluded).

  ## Foreign keys
  See the Ref section at the end of the file.
  '''
}

Table task_comments {
  id         bigint        [pk, increment]
  task_id    bigint        [not null]
  author_id  bigint        [not null]
  body       varchar(2000) [not null, note: 'CHECK: not blank after trimming']
  created_at timestamptz   [not null, default: `now()`]
  updated_at timestamptz   [note: 'Set when the author edits the comment; NULL = never edited']

  indexes {
    (task_id, created_at) [name: 'task_comments_task_created_idx']
  }

  Note: '''
  US-17: only the author can edit or delete their own comment (API check:
  author_id = current user). Deleting a comment is a hard DELETE.
  FK: ON DELETE CASCADE from tasks.
  '''
}

Table checklist_items {
  id         bigint       [pk, increment]
  task_id    bigint       [not null]
  content    varchar(500) [not null, note: 'CHECK: not blank after trimming']
  is_done    boolean      [not null, default: false]
  position   integer      [not null, note: 'Order of items inside one task']
  created_at timestamptz  [not null, default: `now()`]
  updated_at timestamptz  [not null, default: `now()`]

  indexes {
    (task_id, position) [name: 'checklist_items_task_position_idx']
  }

  Note: '''
  US-18: the "2 / 5" progress on the card is
  count(*) FILTER (WHERE is_done) / count(*) per task.
  FK: ON DELETE CASCADE from tasks.
  '''
}

// ─────────────────────────────────────────────
// Epic D — Activity and reliable saving
// ─────────────────────────────────────────────

Table activities {
  id         bigint          [pk, increment, note: 'Also gives a stable "load more" cursor']
  board_id   bigint          [not null]
  task_id    bigint          [note: 'NULL for board/membership events, and after the task is permanently deleted']
  actor_id   bigint          [not null, note: 'Who made the change']
  action     activity_action [not null]
  details    jsonb           [not null, default: `'{}'::jsonb`, note: 'Before/after values for the action; never task titles, descriptions or comment text (US-23)']
  created_at timestamptz     [not null, default: `now()`]

  indexes {
    (task_id, created_at)    [name: 'activities_task_created_idx', note: 'US-26: task history, newest first']
    (board_id, id)           [name: 'activities_board_id_idx', note: 'US-27: board feed, keyset paging on id DESC']
    (board_id, actor_id, id) [name: 'activities_board_actor_idx', note: 'US-27: feed filtered by member']
  }

  Note: '''
  Append-only (US-26): the application role gets INSERT and SELECT only,
  no UPDATE or DELETE. Every write in the stories inserts its activity row
  in the same transaction as the change itself.

  - US-23: FK task_id ON DELETE SET NULL, so the history row survives
    the permanent delete without any task content.
  - US-25: FK board_id ON DELETE CASCADE, so deleting a board removes its history.
  - US-27: "opens the related task, if it still exists" = task_id IS NOT NULL
    AND the task is not trashed.
  - US-29 (live updates): after commit the app publishes the new activity row
    (Postgres NOTIFY or an in-process hub → WebSocket/SSE). No extra table.
  - US-30 (undo): the client sends the inverse operation (e.g. move back,
    restore). It runs through the normal endpoints, so it is saved and logged
    like any other change. No extra table.
  '''
}

// ─────────────────────────────────────────────
// Foreign keys
// cascade  = removed together with the parent (board delete US-25, task delete US-23/US-24)
// set null = keep the row, drop the link (unassign; history survives task delete)
// restrict = user references; deleting user accounts is out of scope
// ─────────────────────────────────────────────

// Epic A
Ref: sessions.user_id       > users.id  [delete: cascade]
Ref: boards.owner_id        > users.id  [delete: restrict]
Ref: board_members.board_id > boards.id [delete: cascade]
Ref: board_members.user_id  > users.id  [delete: cascade]
Ref: board_members.added_by > users.id  [delete: set null]
Ref: board_columns.board_id > boards.id [delete: cascade]

// Epic B / C
Ref: tasks.board_id              > boards.id                    [delete: cascade]
Ref: tasks.(column_id, board_id) > board_columns.(id, board_id) [delete: cascade]
Ref: tasks.assignee_id           > users.id                     [delete: set null]
Ref: tasks.archived_by           > users.id                     [delete: restrict]
Ref: tasks.trashed_by            > users.id                     [delete: restrict]
Ref: tasks.created_by            > users.id                     [delete: restrict]
Ref: tasks.updated_by            > users.id                     [delete: restrict]
Ref: task_comments.task_id       > tasks.id                     [delete: cascade]
Ref: task_comments.author_id     > users.id                     [delete: restrict]
Ref: checklist_items.task_id     > tasks.id                     [delete: cascade]

// Epic D
Ref: activities.board_id > boards.id [delete: cascade]
Ref: activities.task_id  > tasks.id  [delete: set null]
Ref: activities.actor_id > users.id  [delete: restrict]

// ─────────────────────────────────────────────
// Groups (for the diagram)
// ─────────────────────────────────────────────

TableGroup epic_a_boards_and_access {
  users
  sessions
  boards
  board_members
  board_columns
}

TableGroup epic_b_c_tasks {
  tasks
  task_comments
  checklist_items
}

TableGroup epic_d_activity {
  activities
}
